# ============================================
# DevBuddy - Configuracion de Entorno
# ============================================
# copia este archivo a .env y ajusta los valores segun tu configuracion
# cp .env.example .env

# --------------------------------------------
# Ollama Connection
# --------------------------------------------
# url del servicio ollama (en docker usar nombre del servicio)
OLLAMA_URL=http://ollama:11434

# timeout maximo para requests a ollama en segundos
# valores recomendados:
# - 180 para modelos pequenos (1-3B)
# - 300 para modelos medianos (3-7B)
# - 600 para modelos grandes (7B+)
OLLAMA_TIMEOUT=300

# --------------------------------------------
# Model Generation Options
# --------------------------------------------
# temperature: controla la creatividad de las respuestas
# valores: 0.0 (deterministico) a 1.0 (muy creativo)
# recomendado: 0.7 para pair programming
OLLAMA_TEMPERATURE=0.7

# top_p: nucleus sampling threshold
# valores: 0.1 a 1.0
# recomendado: 0.9
OLLAMA_TOP_P=0.9

# top_k: limita tokens candidatos en cada paso
# valores: 1 a 100
# recomendado: 40
OLLAMA_TOP_K=40

# --------------------------------------------
# Notas de Configuracion
# --------------------------------------------
# - el modelo se selecciona desde la interfaz web, no desde .env
# - keep_alive se controla desde la interfaz web
# - los valores aqui son defaults, pueden ser sobreescritos por codigo
